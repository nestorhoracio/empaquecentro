---
const WA_NUMBER = '59899474094';
---

<section class="asesor-section" id="empaquecito">
  <div class="asesor-header">
    <div class="asesor-avatar">🐾</div>
    <div class="asesor-info">
      <span class="asesor-name">Empaquecito</span>
      <span class="asesor-status"><span class="status-dot"></span>En línea</span>
    </div>
  </div>

  <div class="asesor-chat" id="asesor-chat"></div>

  <div class="asesor-input-row">
    <input
      type="text"
      id="asesor-input"
      placeholder="Contame qué necesitás..."
      autocomplete="off"
    />
    <button id="asesor-send" aria-label="Enviar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </button>
  </div>
  <p class="asesor-disclaimer">
    IA experimental · puede cometer errores · siempre confirmá con el local
  </p>
</section>

<script define:vars={{ WA_NUMBER }}>
  const chat = document.getElementById('asesor-chat');
  const input = document.getElementById('asesor-input');
  const sendBtn = document.getElementById('asesor-send');
  let history = [];
  let inactivityTimer = null;
  const INACTIVITY_MS = 5 * 60 * 1000;

  function resetInactivityTimer() {
    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(() => {
      if (history.length > 0) {
        history = [];
        chat.innerHTML = '';
        addMsg('assistant', '¡Hasta luego! 👋 La conversación se reinició por inactividad. Si necesitás algo más, estoy acá.');
        setTimeout(() => {
          chat.innerHTML = '';
          history = [];
          addMsg('assistant', '¡Hola de nuevo! Soy Empaquecito 🐾 ¿En qué te puedo ayudar?');
        }, 3000);
      }
    }, INACTIVITY_MS);
  }

  function checkHumanEscalation(text) {
    const triggers = ['humano', 'persona', 'asesor real', 'hablar con alguien',
                      'quiero hablar', 'me comuniques', 'comunicarme', 'vendedor',
                      'empleado', 'no entiendo', 'no me ayuda'];
    return triggers.some(t => text.toLowerCase().includes(t));
  }

  function escalateToHuman() {
    const resumen = history
      .filter(m => m.role === 'user')
      .map(m => m.content)
      .slice(-3)
      .join(' / ');
    const waText = resumen
      ? `Hola! Estuve chateando con Empaquecito y necesito ayuda de una persona. Esto es lo que consulté: "${resumen}"`
      : `Hola! Estuve chateando con Empaquecito y me gustaría hablar con alguien del equipo.`;
    window.open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(waText)}`, '_blank', 'noopener,noreferrer');
  }

  function addMsg(role, text) {
    // Detectar marcador [WA:nombre producto]
    const waMatch = text.match(/\[WA:([^\]]+)\]/);
    let cleanText = text.replace(/\[WA:[^\]]+\]/g, '').trim();

    const div = document.createElement('div');
    div.className = `msg msg--${role === 'assistant' ? 'bot' : 'user'}`;
    div.textContent = cleanText;

    if (waMatch && role === 'assistant') {
      const productName = waMatch[1];
      const waMsg = encodeURIComponent(`Hola! Empaquecito me recomendó ${productName}, ¿tienen disponibilidad?`);
      const btn = document.createElement('a');
      btn.href = `https://wa.me/${WA_NUMBER}?text=${waMsg}`;
      btn.target = '_blank';
      btn.rel = 'noopener noreferrer';
      btn.className = 'msg__wa-btn';
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.136.561 4.14 1.535 5.874L0 24l6.29-1.508A11.934 11.934 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.493-5.178-1.355l-.371-.22-3.735.895.944-3.64-.242-.385A9.942 9.942 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg> Consultar por WhatsApp`;
      div.appendChild(btn);
    }

    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'msg msg--bot msg--typing';
    div.id = 'typing-indicator';
    div.innerHTML = '<span></span><span></span><span></span>';
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  function hideTyping() {
    const el = document.getElementById('typing-indicator');
    if (el) el.remove();
  }

  async function askEmpaquecito(text) {
    resetInactivityTimer();
    history.push({ role: 'user', content: text });
    showTyping();
    sendBtn.disabled = true;
    input.disabled = true;

    try {
      const res = await fetch('/api/empaquecito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      const data = await res.json();
      hideTyping();

      if (!res.ok) {
        addMsg('assistant', 'Ups, hubo un problema al conectar. Intentá de nuevo en un momento.');
        history.pop();
        return;
      }

      const reply = data.content?.[0]?.text ?? 'No pude procesar tu consulta. Intentá de nuevo.';
      history.push({ role: 'assistant', content: reply });
      addMsg('assistant', reply);
    } catch (err) {
      // Bug corregido: antes `data` estaba fuera de scope aquí
      hideTyping();
      addMsg('assistant', 'No pude conectarme. Verificá tu conexión e intentá de nuevo.');
      history.pop();
    } finally {
      sendBtn.disabled = false;
      input.disabled = false;
      input.focus();
    }
  }

  function handleSend() {
    const text = input.value.trim();
    if (!text) return;
    resetInactivityTimer();

    if (checkHumanEscalation(text)) {
      addMsg('user', text);
      input.value = '';
      addMsg('assistant', 'Entendido, te conecto ahora mismo con el equipo de Centro Empaque 👋');
      setTimeout(() => escalateToHuman(), 600);
      return;
    }

    addMsg('user', text);
    input.value = '';
    askEmpaquecito(text);
  }

  sendBtn.addEventListener('click', handleSend);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  });

  // Saludo inicial
  setTimeout(() => {
    addMsg('assistant', '¡Hola! Soy Empaquecito 🐾 Contame qué tipo de producto querés empacar y te ayudo a encontrar lo que necesitás.');
  }, 400);
</script>

<style>
  .asesor-section {
    background: var(--color-bg);
    border: 1.5px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    max-width: 600px;
    margin: 2rem auto 0;
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  }

  .asesor-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--color-primary);
    color: white;
  }

  .asesor-avatar {
    font-size: 1.8rem;
    line-height: 1;
  }

  .asesor-name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
  }

  .asesor-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: #4ade80;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .asesor-chat {
    height: 280px;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--color-bg-soft, #f7f9fc);
  }

  :global(.msg) {
    max-width: 80%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  :global(.msg--user) {
    align-self: flex-end;
    background: var(--color-primary);
    color: white;
    border-bottom-right-radius: 3px;
  }

  :global(.msg--bot) {
    align-self: flex-start;
    background: white;
    color: var(--color-text);
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 3px;
  }

  :global(.msg--typing) {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 12px 16px;
  }

  :global(.msg--typing span) {
    width: 6px;
    height: 6px;
    background: #9ca3af;
    border-radius: 50%;
    animation: bounce 1.2s infinite;
  }

  :global(.msg--typing span:nth-child(2)) { animation-delay: 0.2s; }
  :global(.msg--typing span:nth-child(3)) { animation-delay: 0.4s; }

  @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-6px); }
  }

  :global(.msg__wa-btn) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 7px 14px;
    background: #25d366;
    color: white;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  :global(.msg__wa-btn:hover) {
    background: #1ebe5d;
  }

  .asesor-input-row {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    background: white;
    border-top: 1px solid #e5e7eb;
  }

  #asesor-input {
    flex: 1;
    padding: 9px 14px;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s;
  }

  #asesor-input:focus {
    border-color: var(--color-primary);
  }

  #asesor-send {
    padding: 9px 14px;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: background 0.2s, transform 0.1s;
  }

  #asesor-send:hover { background: #1640b0; }
  #asesor-send:active { transform: scale(0.95); }
  #asesor-send:disabled { opacity: 0.5; cursor: not-allowed; }

  .asesor-disclaimer {
    text-align: center;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    padding: 8px 16px;
    background: white;
  }
</style>
