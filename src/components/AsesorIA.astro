---
// src/components/AsesorIA.astro
const WA_NUMBER = '59898024132';
---

<section class="asesor-section" id="empaquecito">
  <div class="container">

    <div class="asesor-header">
      <div class="asesor-avatar" aria-hidden="true">
        <!-- Reemplazar img src con el avatar real de Empaquecito cuando esté disponible -->
        <div class="asesor-avatar__placeholder">🐾</div>
      </div>
      <div class="asesor-header__text">
        <h2 class="heading-display heading-md">Empaquecito</h2>
        <p>Tu asesor de empaques · Responde al instante</p>
      </div>
      <span class="asesor-online" aria-label="En línea">
        <span class="asesor-online__dot"></span> En línea
      </span>
    </div>

    <div class="asesor-chat" id="asesor-chat" aria-live="polite" aria-label="Chat con Empaquecito">
      <!-- Los mensajes se insertan acá por JS -->
    </div>

    <div class="asesor-input-wrap">
      <input
        type="text"
        id="asesor-input"
        class="asesor-input"
        placeholder="Escribí tu consulta..."
        autocomplete="off"
        maxlength="300"
        aria-label="Mensaje para Empaquecito"
      />
      <button id="asesor-send" class="btn btn-primary asesor-send" aria-label="Enviar mensaje">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>

    <p class="asesor-disclaimer">
      Empaquecito usa IA · Las respuestas son orientativas · Precios finales por WhatsApp
    </p>

  </div>
</section>

<style>
  .asesor-section {
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-12);
  }

  .asesor-section .container {
    max-width: 680px;
  }

  /* Header */
  .asesor-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .asesor-avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    overflow: hidden;
    flex-shrink: 0;
    border: 3px solid var(--color-primary);
  }

  .asesor-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .asesor-avatar__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-primary-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
  }

  .asesor-header__text h2 {
    font-size: var(--text-xl);
    margin-bottom: 2px;
  }

  .asesor-header__text p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .asesor-online {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-secondary);
  }

  .asesor-online__dot {
    width: 8px;
    height: 8px;
    background: var(--color-secondary);
    border-radius: var(--radius-full);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  /* Chat */
  .asesor-chat {
    min-height: 280px;
    max-height: 420px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    scroll-behavior: smooth;
  }

  /* Mensajes — generados por JS con estas clases */
  :global(.msg) {
    display: flex;
    gap: var(--space-3);
    max-width: 85%;
    animation: fadein 0.2s ease;
  }

  @keyframes fadein {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  :global(.msg--bot) {
    align-self: flex-start;
  }

  :global(.msg--user) {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  :global(.msg__bubble) {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  :global(.msg--bot .msg__bubble) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-bottom-left-radius: 4px;
    color: var(--color-text);
  }

  :global(.msg--user .msg__bubble) {
    background: var(--color-primary);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  :global(.msg__avatar) {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    background: var(--color-primary-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
    align-self: flex-end;
  }

  /* Typing indicator */
  :global(.msg--typing .msg__bubble) {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: var(--space-3) var(--space-5);
  }

  :global(.typing-dot) {
    width: 7px;
    height: 7px;
    background: var(--color-text-muted);
    border-radius: var(--radius-full);
    animation: bounce 1.2s infinite;
  }

  :global(.typing-dot:nth-child(2)) { animation-delay: 0.2s; }
  :global(.typing-dot:nth-child(3)) { animation-delay: 0.4s; }

  @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); }
    30%           { transform: translateY(-6px); }
  }

  /* Botón WA dentro del chat */
  :global(.msg__wa-btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: #25D366;
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  :global(.msg__wa-btn:hover) { background: #1DAE52; }

  /* Input */
  .asesor-input-wrap {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .asesor-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text);
    background: var(--color-bg);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .asesor-input:focus {
    border-color: var(--color-primary);
  }

  .asesor-send {
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-4);
    flex-shrink: 0;
  }

  .asesor-disclaimer {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    opacity: 0.7;
  }
</style>

<script define:vars={{ WA_NUMBER }}>
  const chat    = document.getElementById('asesor-chat');
  const input   = document.getElementById('asesor-input');
  const sendBtn = document.getElementById('asesor-send');

  // Historial de mensajes para la API
  const history = [];

  // ── Helpers ──────────────────────────────────────────────

  function scrollBottom() {
    chat.scrollTop = chat.scrollHeight;
  }

  function addMsg(role, text) {
    const isBot = role === 'bot';
    const div   = document.createElement('div');
    div.className = `msg msg--${isBot ? 'bot' : 'user'}`;

    // Detectar si la respuesta tiene el marcador [WA:...]
    let waBtn = '';
    const waMatch = text.match(/\[WA:([^\]]+)\]/);
    if (waMatch) {
      const producto = waMatch[1].trim();
      const msg = encodeURIComponent(`Hola! Empaquecito me recomendó: *${producto}*. ¿Tienen disponibilidad?`);
      waBtn = `<a href="https://wa.me/${WA_NUMBER}?text=${msg}" target="_blank" rel="noopener noreferrer" class="msg__wa-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Consultar por WhatsApp
      </a>`;
      text = text.replace(/\[WA:[^\]]+\]/, '').trim();
    }

    div.innerHTML = `
      ${isBot ? '<div class="msg__avatar">🐾</div>' : ''}
      <div class="msg__bubble">${text}${waBtn}</div>
      ${!isBot ? '<div class="msg__avatar" style="background:var(--color-primary-soft)">😊</div>' : ''}
    `;

    chat.appendChild(div);
    scrollBottom();
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'msg msg--bot msg--typing';
    div.id = 'typing-indicator';
    div.innerHTML = `
      <div class="msg__avatar">🐾</div>
      <div class="msg__bubble">
        <span class="typing-dot"></span>
        <span class="typing-dot"></span>
        <span class="typing-dot"></span>
      </div>`;
    chat.appendChild(div);
    scrollBottom();
  }

  function hideTyping() {
    document.getElementById('typing-indicator')?.remove();
  }

  function setLoading(loading) {
    sendBtn.disabled = loading;
    input.disabled   = loading;
    sendBtn.style.opacity = loading ? '0.6' : '1';
  }

  // ── Llamada a la API ──────────────────────────────────────

  async function askEmpaquecito(userMessage) {
    history.push({ role: 'user', content: userMessage });

    setLoading(true);
    showTyping();

    try {
      const res = await fetch('/api/empaquecito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      const data = await res.json();

      if (data.error) {
        hideTyping();
        addMsg('bot', 'Ups, tuve un problema. Intentá de nuevo en un momento 🙏');
        return;
      }

      const reply = data.content?.[0]?.text ?? 'No pude procesar tu consulta.';
      history.push({ role: 'assistant', content: reply });

      hideTyping();
      addMsg('bot', reply);

    } catch {
      hideTyping();
      const errMsg = data?.error ?? 'Sin conexión. Intentá de nuevo.';
      addMsg('bot', `⚠️ ${errMsg}`);
    } finally {
      setLoading(false);
      input.focus();
    }
  }

  // ── Eventos ───────────────────────────────────────────────

  function handleSend() {
    const text = input.value.trim();
    if (!text) return;
    addMsg('user', text);
    input.value = '';
    askEmpaquecito(text);
  }

  sendBtn.addEventListener('click', handleSend);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  });

  // ── Saludo inicial ────────────────────────────────────────

  setTimeout(() => {
    addMsg('bot', '¡Hola! Soy Empaquecito 🐾 ¿Para qué tipo de producto necesitás el empaque?');
  }, 400);
</script>
