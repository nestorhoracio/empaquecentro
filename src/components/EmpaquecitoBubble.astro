---
const WA_NUMBER = '59899474094';
---

<div id="eq-bubble" aria-label="Abrir asesor Empaquecito" role="button" tabindex="0" aria-expanded="false">
  <span class="eq-bubble__closed">🐾 ¿Qué empaque necesitás?</span>
  <span class="eq-bubble__open" aria-hidden="true">🐾 ✕</span>
</div>

<div id="eq-panel" aria-hidden="true">
  <div class="eq-panel__header">
    <div class="eq-panel__avatar">🐾</div>
    <div class="eq-panel__info">
      <span class="eq-panel__name">Empaquecito</span>
      <span class="eq-panel__status"><span class="eq-status-dot"></span>En línea</span>
    </div>
    <button class="eq-panel__close" id="eq-close" aria-label="Cerrar">✕</button>
  </div>

  <div class="eq-panel__messages" id="eq-messages"></div>

  <div class="eq-panel__footer">
    <input
      type="text"
      id="eq-input"
      placeholder="Escribí tu consulta..."
      autocomplete="off"
    />
    <button id="eq-send" aria-label="Enviar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </button>
  </div>
</div>

<script define:vars={{ WA_NUMBER }}>
  const bubble  = document.getElementById('eq-bubble');
  const panel   = document.getElementById('eq-panel');
  const closeBtn = document.getElementById('eq-close');
  const messages = document.getElementById('eq-messages');
  const input   = document.getElementById('eq-input');
  const sendBtn = document.getElementById('eq-send');

  let history = [];
  let greeted = false;

  // ─── Panel open / close ──────────────────────────────────────────────────
  function openPanel() {
    panel.setAttribute('aria-hidden', 'false');
    bubble.setAttribute('aria-expanded', 'true');
    panel.classList.add('eq-panel--open');
    bubble.classList.add('eq-bubble--open');

    if (!greeted) {
      greeted = true;
      setTimeout(() => {
        addMsg('assistant', '¡Hola! Soy Empaquecito 🐾 Contame qué tipo de producto querés empacar y te ayudo a encontrar lo que necesitás.');
      }, 300);
    }
    setTimeout(() => input.focus(), 350);
  }

  function closePanel() {
    panel.setAttribute('aria-hidden', 'true');
    bubble.setAttribute('aria-expanded', 'false');
    panel.classList.remove('eq-panel--open');
    bubble.classList.remove('eq-bubble--open');
  }

  // ─── API pública: abre con mensaje de contexto desde los kits ───────────
  // Uso: window.Empaquecito.openWithContext("Hola, me interesa el Kit Repostería 🎂")
  window.Empaquecito = {
    openWithContext: function(contextMsg) {
      // Si ya hubo conversación, reseteamos para el nuevo contexto
      if (history.length > 0) {
        history = [];
        greeted = false;
        messages.innerHTML = '';
      }
      openPanel();
      // Pequeño delay para que la animación de apertura termine antes del saludo
      setTimeout(() => {
        addMsg('user', contextMsg);
        askEmpaquecito(contextMsg);
      }, 400);
    }
  };

  // ─── Mensajes ─────────────────────────────────────────────────────────────
  function addMsg(role, text) {
    const waMatch = text.match(/\[WA:([^\]]+)\]/);
    const cleanText = text.replace(/\[WA:[^\]]+\]/g, '').trim();

    const div = document.createElement('div');
    div.className = `eq-msg eq-msg--${role === 'assistant' ? 'bot' : 'user'}`;
    div.textContent = cleanText;

    if (waMatch && role === 'assistant') {
      const productName = waMatch[1];
      const waMsg = encodeURIComponent(`Hola! El asesor me recomendó ${productName}, ¿tienen disponibilidad?`);
      const btn = document.createElement('a');
      btn.href = `https://wa.me/${WA_NUMBER}?text=${waMsg}`;
      btn.target = '_blank';
      btn.rel = 'noopener noreferrer';
      btn.className = 'eq-wa-btn';
      btn.textContent = 'WhatsApp →';
      div.appendChild(btn);
    }

    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'eq-msg eq-msg--bot eq-msg--typing';
    div.id = 'eq-typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function hideTyping() {
    const el = document.getElementById('eq-typing');
    if (el) el.remove();
  }

  // ─── API call ─────────────────────────────────────────────────────────────
  async function askEmpaquecito(text) {
    history.push({ role: 'user', content: text });
    showTyping();
    sendBtn.disabled = true;
    input.disabled = true;

    try {
      const res = await fetch('/api/empaquecito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      const data = await res.json();
      hideTyping();

      if (!res.ok) {
        addMsg('assistant', 'Ups, hubo un problema al conectar. Intentá de nuevo en un momento.');
        history.pop();
        return;
      }

      const reply = data.content?.[0]?.text ?? 'No pude procesar tu consulta. Intentá de nuevo.';
      history.push({ role: 'assistant', content: reply });
      addMsg('assistant', reply);
    } catch (err) {
      hideTyping();
      addMsg('assistant', 'No pude conectarme. Verificá tu conexión e intentá de nuevo.');
      history.pop();
    } finally {
      sendBtn.disabled = false;
      input.disabled = false;
    }
  }

  // ─── Envío ────────────────────────────────────────────────────────────────
  function handleSend() {
    const text = input.value.trim();
    if (!text) return;
    addMsg('user', text);
    input.value = '';
    askEmpaquecito(text);
  }

  sendBtn.addEventListener('click', handleSend);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  });

  // ─── Toggle bubble ────────────────────────────────────────────────────────
  bubble.addEventListener('click', () => {
    panel.classList.contains('eq-panel--open') ? closePanel() : openPanel();
  });
  bubble.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      panel.classList.contains('eq-panel--open') ? closePanel() : openPanel();
    }
  });
  closeBtn.addEventListener('click', closePanel);
</script>

<style>
  /* ── Bubble ─────────────────────────────────────────────────────────────── */
  #eq-bubble {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 999;
    background: var(--color-primary);
    color: white;
    padding: 12px 18px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(27, 79, 216, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    user-select: none;
  }

  #eq-bubble:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(27, 79, 216, 0.45);
  }

  .eq-bubble__open { display: none; }

  #eq-bubble.eq-bubble--open .eq-bubble__closed { display: none; }
  #eq-bubble.eq-bubble--open .eq-bubble__open   { display: inline; }

  /* ── Panel ──────────────────────────────────────────────────────────────── */
  #eq-panel {
    position: fixed;
    bottom: 80px;
    left: 24px;
    z-index: 998;
    width: 320px;
    height: 440px;
    background: white;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  #eq-panel.eq-panel--open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  .eq-panel__header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--color-primary);
    color: white;
    flex-shrink: 0;
  }

  .eq-panel__avatar { font-size: 1.5rem; line-height: 1; }

  .eq-panel__info { flex: 1; }

  .eq-panel__name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .eq-panel__status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.73rem;
    opacity: 0.85;
  }

  .eq-status-dot {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    animation: eq-pulse 2s infinite;
  }

  @keyframes eq-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .eq-panel__close {
    background: none;
    border: none;
    color: white;
    font-size: 1rem;
    cursor: pointer;
    opacity: 0.7;
    padding: 4px;
    line-height: 1;
    transition: opacity 0.15s;
  }
  .eq-panel__close:hover { opacity: 1; }

  /* ── Messages ───────────────────────────────────────────────────────────── */
  .eq-panel__messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-bg-soft, #f7f9fc);
  }

  :global(.eq-msg) {
    max-width: 85%;
    padding: 9px 12px;
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.5;
    word-break: break-word;
  }

  :global(.eq-msg--user) {
    align-self: flex-end;
    background: var(--color-primary);
    color: white;
    border-bottom-right-radius: 3px;
  }

  :global(.eq-msg--bot) {
    align-self: flex-start;
    background: white;
    color: var(--color-text);
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 3px;
  }

  :global(.eq-msg--typing) {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 10px 14px;
  }

  :global(.eq-msg--typing span) {
    width: 6px;
    height: 6px;
    background: #9ca3af;
    border-radius: 50%;
    animation: eq-bounce 1.2s infinite;
  }

  :global(.eq-msg--typing span:nth-child(2)) { animation-delay: 0.2s; }
  :global(.eq-msg--typing span:nth-child(3)) { animation-delay: 0.4s; }

  @keyframes eq-bounce {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-5px); }
  }

  :global(.eq-wa-btn) {
    display: inline-block;
    margin-top: 7px;
    padding: 5px 12px;
    background: #25d366;
    color: white;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s;
  }

  :global(.eq-wa-btn:hover) { background: #1ebe5d; }

  /* ── Footer / input ─────────────────────────────────────────────────────── */
  .eq-panel__footer {
    display: flex;
    gap: 8px;
    padding: 10px 12px;
    background: white;
    border-top: 1px solid #e5e7eb;
    flex-shrink: 0;
  }

  #eq-input {
    flex: 1;
    padding: 8px 12px;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.85rem;
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s;
  }

  #eq-input:focus { border-color: var(--color-primary); }

  #eq-send {
    padding: 8px 12px;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: background 0.15s, transform 0.1s;
  }

  #eq-send:hover  { background: #1640b0; }
  #eq-send:active { transform: scale(0.93); }
  #eq-send:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {
    #eq-panel {
      width: calc(100vw - 24px);
      left: 12px;
      bottom: 76px;
    }
  }
</style>
