---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';

const WA_NUMBER  = '59899474094';
const WA_MESSAGE = 'Hola Centro Empaque! Quiero hacer una consulta 😊';
const waLink     = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_MESSAGE)}`;

// ← Completar con el link real de Google Maps (el que tienen en la bio de IG)
const MAPS_LINK = 'https://maps.app.goo.gl/zkUsFS4HN9HAzN3Y7';
---

<Layout title="Contacto" description="Contactá a Centro Empaque por WhatsApp o visitá nuestro local en Uruguay.">

  <section class="section--soft" style="padding-block:var(--space-16) var(--space-12)">
    <div class="container">
      <span class="badge badge--primary">Contacto</span>
      <h1 class="heading-display heading-lg" style="margin-top:var(--space-3)">
        Estamos para ayudarte
      </h1>
      <p style="margin-top:var(--space-4);color:var(--color-text-muted);font-size:var(--text-lg)">
        Escribinos, visitanos o seguinos en Instagram. Te respondemos rápido.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">

      <!-- Canales -->
      <div class="contact-channels">

        <a href={waLink} target="_blank" rel="noopener noreferrer" class="contact-card contact-card--wa">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <div>
            <h3>WhatsApp</h3>
            <p>Respondemos rápido en horario comercial</p>
          </div>
          <span class="contact-card__arrow" aria-hidden="true">→</span>
        </a>

        <a href="https://instagram.com/empaquecentro" target="_blank" rel="noopener noreferrer" class="contact-card contact-card--ig">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <div>
            <h3>Instagram</h3>
            <p>@empaquecentro — Seguinos para novedades</p>
          </div>
          <span class="contact-card__arrow" aria-hidden="true">→</span>
        </a>

        <a href={MAPS_LINK} target="_blank" rel="noopener noreferrer" class="contact-card contact-card--map">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <div>
            <h3>Local físico</h3>
            <!-- ← Completar con dirección real -->
            <p>18 de Julio esquina Adelaida Puyol</p>
          </div>
          <span class="contact-card__arrow" aria-hidden="true">→</span>
        </a>

      </div>

      <!-- Horarios (placeholder) -->
      <div class="contact-hours">
        <h2 class="heading-display" style="font-size:var(--text-2xl);margin-bottom:var(--space-6)">
          Días y horarios
        </h2>
        <!-- ← Completar con horarios reales -->
        <table class="hours-table">
          <tbody>
            {[
              { dia: 'Lunes a viernes', hora: 'A confirmar' },
              { dia: 'Sábados',         hora: 'A confirmar' },
              { dia: 'Domingos',        hora: 'Cerrado' },
            ].map(h => (
              <tr>
                <td>{h.dia}</td>
                <td class="hours-table__value">{h.hora}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="contact-hours__note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
          </svg>
          Las consultas por WhatsApp se responden dentro del horario comercial.
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 2px solid transparent;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .contact-card div h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .contact-card div p {
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  .contact-card__arrow {
    margin-left: auto;
    font-size: var(--text-xl);
    opacity: 0.4;
    transition: transform var(--transition-fast);
  }

  .contact-card:hover .contact-card__arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .contact-card--wa {
    background: #F0FDF4;
    border-color: #86EFAC;
    color: #166534;
  }
  .contact-card--wa:hover { border-color: #22C55E; background: #DCFCE7; }

  .contact-card--ig {
    background: #FDF2F8;
    border-color: #F9A8D4;
    color: #9D174D;
  }
  .contact-card--ig:hover { border-color: #EC4899; background: #FCE7F3; }

  .contact-card--map {
    background: var(--color-primary-soft);
    border-color: #93C5FD;
    color: var(--color-primary-dark);
  }
  .contact-card--map:hover { border-color: var(--color-primary); }

  /* Hours table */
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-6);
  }

  .hours-table tr {
    border-bottom: 1px solid var(--color-border);
  }

  .hours-table td {
    padding: var(--space-4) 0;
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .hours-table__value {
    text-align: right;
    font-weight: 700;
    color: var(--color-text);
  }

  .contact-hours__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .contact-hours__note svg { flex-shrink: 0; margin-top: 2px; }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
