---
import Layout from '../layouts/Layout.astro';

const WA_NUMBER = '59899474094';

const kits = [
  {
    id: 'reposteria',
    emoji: '🎂',
    titulo: 'Kit Repostería',
    desc: 'Para torterías, pastelerías y reposteras artesanales.',
    productos: ['Cajas para torta', 'Papel tissue', 'Cintas decorativas', 'Bolsas celofán'],
    color: '#FFF3E0',
    colorBorder: '#F97316',
    contextMsg: 'Hola! Me interesa el Kit Repostería 🎂 ¿Me podés contar qué incluye y cómo funciona?',
  },
  {
    id: 'boutique',
    emoji: '👗',
    titulo: 'Kit Boutique',
    desc: 'Para tiendas de ropa y accesorios.',
    productos: ['Bolsas kraft con manija', 'Papel tissue de colores', 'Cinta satén', 'Stickers personalizados'],
    color: '#FCE7F3',
    colorBorder: '#EC4899',
    contextMsg: 'Hola! Me interesa el Kit Boutique 👗 ¿Me podés contar qué incluye y cómo funciona?',
  },
  {
    id: 'cosmeticos',
    emoji: '💄',
    titulo: 'Kit Cosméticos',
    desc: 'Para emprendedoras de cosmética y cuidado personal.',
    productos: ['Cajas armables', 'Bolsas celofán', 'Papel tissue', 'Lacitos decorativos'],
    color: '#F0FDF4',
    colorBorder: '#22C55E',
    contextMsg: 'Hola! Me interesa el Kit Cosméticos 💄 ¿Me podés contar qué incluye y cómo funciona?',
  },
  {
    id: 'regaleria',
    emoji: '🎁',
    titulo: 'Kit Regalería',
    desc: 'Para tiendas de regalos y detalles especiales.',
    productos: ['Cajas con tapa', 'Papel de regalo', 'Cintas y lacitos', 'Cotillón'],
    color: '#EFF6FF',
    colorBorder: '#3B82F6',
    contextMsg: 'Hola! Me interesa el Kit Regalería 🎁 ¿Me podés contar qué incluye y cómo funciona?',
  },
];
---

<Layout
  title="Kits por rubro"
  description="Kits de empaque armados para tu tipo de negocio: repostería, boutique, cosméticos y regalería."
>
  <section class="kits-hero">
    <span class="kits-badge">Armado para vos</span>
    <h1>Kits por rubro</h1>
    <p>Seleccionamos los empaques ideales para cada tipo de negocio.<br />Elegí el tuyo y Empaquecito te asesora al instante.</p>
  </section>

  <section class="kits-section">
    <div class="kits-grid">
      {kits.map((kit) => (
        <article
          class="kit-card"
          style={`--kit-color: ${kit.color}; --kit-border: ${kit.colorBorder};`}
        >
          <div class="kit-card__emoji">{kit.emoji}</div>
          <h2 class="kit-card__title">{kit.titulo}</h2>
          <p class="kit-card__desc">{kit.desc}</p>

          <ul class="kit-card__list">
            {kit.productos.map((p) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5"
                  style={`color: ${kit.colorBorder}`}>
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {p}
              </li>
            ))}
          </ul>

          <div class="kit-card__actions">
            <!-- Botón principal: abre Empaquecito con contexto del kit -->
            <button
              class="btn-asesor"
              data-context={kit.contextMsg}
              style={`--btn-color: ${kit.colorBorder};`}
            >
              🐾 Consultar con Empaquecito
            </button>

            <!-- Botón secundario: ir directo a WhatsApp -->
            <a
              href={`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(`Hola! Me interesa el ${kit.titulo}, ¿pueden asesorarme?`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-wa"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.136.561 4.14 1.535 5.874L0 24l6.29-1.508A11.934 11.934 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.493-5.178-1.355l-.371-.22-3.735.895.944-3.64-.242-.385A9.942 9.942 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
              </svg>
              Pedir por WhatsApp
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<script>
  // Conectar los botones de kit con window.Empaquecito.openWithContext
  document.querySelectorAll('.btn-asesor').forEach((btn) => {
    btn.addEventListener('click', () => {
      const contextMsg = btn.getAttribute('data-context');
      if (window.Empaquecito && contextMsg) {
        window.Empaquecito.openWithContext(contextMsg);
      }
    });
  });
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .kits-hero {
    text-align: center;
    padding: 3.5rem 1rem 2rem;
  }

  .kits-badge {
    display: inline-block;
    background: var(--color-accent, #F4C430);
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .kits-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .kits-hero p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Grid ───────────────────────────────────────────────────────────────── */
  .kits-section {
    padding: 1rem 1.5rem 4rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .kits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .kits-grid { grid-template-columns: 1fr; }
  }

  /* ── Card ───────────────────────────────────────────────────────────────── */
  .kit-card {
    background: var(--kit-color);
    border: 2px solid var(--kit-border);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .kit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  }

  .kit-card__emoji {
    font-size: 2.2rem;
    line-height: 1;
  }

  .kit-card__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 0;
  }

  .kit-card__desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.5;
  }

  .kit-card__list {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .kit-card__list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--color-text);
  }

  /* ── Actions ────────────────────────────────────────────────────────────── */
  .kit-card__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
    padding-top: 1rem;
  }

  /* Botón Empaquecito — color dinámico por kit */
  .btn-asesor {
    width: 100%;
    padding: 11px 16px;
    background: var(--btn-color);
    color: white;
    border: none;
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
    text-align: center;
  }

  .btn-asesor:hover  { opacity: 0.88; }
  .btn-asesor:active { transform: scale(0.97); }

  /* Botón WhatsApp — secundario */
  .btn-wa {
    width: 100%;
    padding: 9px 16px;
    background: white;
    color: var(--color-text);
    border: 1.5px solid #d1d5db;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-wa:hover {
    border-color: #25d366;
    color: #16a34a;
  }
</style>
